# Copy this file to `.env` and fill in your real values.
# Never commit the real `.env` file.

# Backend API base URL.
# - Local dev: leave unset to use the Vite proxy (/api -> https://aps-minds.onrender.com)
# - Production: set to the deployed FastAPI backend URL, e.g.
#   https://your-backend-domain.vercel.app/api
VITE_API_URL=

# Backend ARCTES chat endpoint override (optional).
# If unset, falls back to VITE_API_URL, then the local dev default.
VITE_ARCTES_API_URL=
