# Copy this file to .env and fill in your real values.
# Never commit the real .env file.

# ============================================================
# AUTH & DATABASE
# ============================================================
# Supabase PostgreSQL connection string (no password hardcoded in source).
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/postgres

# JWT signing secret — use a long random string in production.
SECRET_KEY=change-me-to-a-long-random-secret

# JWT algorithm
ALGORITHM=HS256

# Access token lifetime in minutes (default 1440 = 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed CORS origins (frontend).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================
# ARCTES — OpenRouter / Chat (preserved)
# ============================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ARCTES_MODEL=openai/gpt-5-nano
